#!/bin/sh
# Con core.hooksPath global, git deja de mirar .git/hooks de cada repo.
# Este puente corre el hook propio del repo, si lo tiene (ADR-041).
hook=$(basename "$0")
repo_hook="$(git rev-parse --git-common-dir)/hooks/$hook"
if [ -f "$repo_hook" ] && [ -x "$repo_hook" ]; then
  exec "$repo_hook" "$@"
fi
exit 0
